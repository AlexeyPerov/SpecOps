{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. The editor legitimately needs to read and write anywhere under $HOME, so the allow scopes stay broad; the deny lists remove the credential material a text editor has no reason to touch (private keys, cloud and registry tokens, keychains). Tauri applies deny before allow and merges fs plugin scopes, but the rules are repeated per permission so each grant is auditable on its own. Files people do hand-edit (~/.ssh/config, ~/.npmrc, ~/.aws/config) are deliberately left open.",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }],
      "deny": [
        { "path": "$HOME/.ssh/id_*" },
        { "path": "$HOME/.ssh/*_rsa" },
        { "path": "$HOME/.ssh/*_ed25519" },
        { "path": "$HOME/.aws/credentials" },
        { "path": "$HOME/.git-credentials" },
        { "path": "$HOME/.netrc" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.docker/config.json" },
        { "path": "$HOME/.kube/config" },
        { "path": "$HOME/.config/gh/hosts.yml" },
        { "path": "$HOME/Library/Keychains/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }],
      "deny": [
        { "path": "$HOME/.ssh/id_*" },
        { "path": "$HOME/.ssh/*_rsa" },
        { "path": "$HOME/.ssh/*_ed25519" },
        { "path": "$HOME/.aws/credentials" },
        { "path": "$HOME/.git-credentials" },
        { "path": "$HOME/.netrc" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.docker/config.json" },
        { "path": "$HOME/.kube/config" },
        { "path": "$HOME/.config/gh/hosts.yml" },
        { "path": "$HOME/Library/Keychains/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }],
      "deny": [{ "path": "$HOME/.gnupg/**" }, { "path": "$HOME/Library/Keychains/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.git-credentials" },
        { "path": "$HOME/.netrc" },
        { "path": "$HOME/.docker/config.json" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.config/gh/**" },
        { "path": "$HOME/Library/Keychains/**" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "$HOME/**" }],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.config/gh/**" },
        { "path": "$HOME/Library/Keychains/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$HOME/**" }],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.config/gh/**" },
        { "path": "$HOME/Library/Keychains/**" }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }]
    },
    "log:default",
    "opener:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-start-dragging",
    "core:window:allow-close"
  ]
}
