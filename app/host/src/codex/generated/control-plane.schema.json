          "defaultReasoningEffort": {
            "$ref": "#/definitions/ReasoningEffort"
          },
          "defaultServiceTier": {
            "default": null,
            "description": "Catalog default service tier id for this model, when one is configured.",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "inputModalities": {
            "default": [
              "text",
              "image"
            ],
            "items": {
              "$ref": "#/definitions/InputModality"
            },
            "type": "array"
          },
          "isDefault": {
            "type": "boolean"
          },
          "model": {
            "type": "string"
          },
          "modelSpecialty": {
            "default": null,
