{
  "name": "@specops/agent-host",
  "version": "0.1.0",
  "private": true,
  "description": "SpecOps Agent Host — secret-safe local host that owns runtime adapters outside the WebView.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "specops-agent-host": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "../node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "test": "../node_modules/.bin/vitest run",
    "test:e2e": "node scripts/build.mjs && ../node_modules/.bin/vitest run src/process.test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.6.2",
    "vitest": "^4.1.7"
  }
}
